# Copy to backend/.env  (Windows: copy backend\.env.example backend\.env). NEVER commit the real .env.

# ---- Admin login (existing) ----
SLEEPGPT_ADMIN_USERNAME=admin
SLEEPGPT_ADMIN_PASSWORD=change-me
# ---- Session tokens: long random string. If empty, a random key is generated in backend/data/.session_secret
SLEEPGPT_SECRET_KEY=
SLEEPGPT_TOKEN_TTL_HOURS=12
SLEEPGPT_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---- LLM (existing) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Ubidots (server-side only) ----
UBIDOTS_TOKEN=
UBIDOTS_BASE_URL=https://industrial.api.ubidots.com
UBIDOTS_DEVICE_LABEL=esp32_health_monitor
UBIDOTS_SPO2_VARIABLE=spo2
UBIDOTS_HEART_RATE_VARIABLE=heart_rate
UBIDOTS_ECG_VARIABLE=ecg
UBIDOTS_RESPIRATORY_PRESSURE_VARIABLE=respiratory_pressure
UBIDOTS_TEMPERATURE_VARIABLE=temperature

# ---- SomnNET normalization ----
# The original training mean/std are NOT available. Until they are, leave the next three lines empty:
# the pipeline then uses per-window z-score ("window") and every result is labelled UNVALIDATED.
# When you obtain them from the original training data, set mode=global and fill both values.
SOMNNET_NORMALIZATION_MODE=
SOMNNET_TRAIN_MEAN=
SOMNNET_TRAIN_STD=

# ---- Optional ML tuning (defaults shown) ----
# SOMNNET_APNEA_CLASS_INDEX=1       # softmax output index treated as "apnea"
# SOMNNET_APNEA_THRESHOLD=0.5
# SOMNNET_MIN_EVENT_WINDOWS=1       # consecutive positive 11 s windows merged into one event
# SPO2_VALID_MIN=50
# SPO2_VALID_MAX=100
# ML_MIN_DURATION_MINUTES=5
# ML_RELIABLE_DURATION_MINUTES=60
# SLEEPGPT_ML_DB=                   # SQLite path (default backend/data/ml.sqlite3)
